<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="16777216" />
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet" arguments=".\SecurityHealth.Api.dll"
                  hostingModel="inprocess" stdoutLogEnabled="false" />
    </system.webServer>
  </location>
</configuration>
